<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Colonists: we adopted a new pet -->
  <ThoughtDef>
    <defName>MLAP_AdoptedNewPet</defName>
    <durationDays>10</durationDays>
    <stackLimit>2</stackLimit>
    <stages>
      <li>
        <label>Adopted a new pet</label>
        <description>We’ve taken in a new pet. Giving them a home and a purpose feels right.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Slave: I've been adopted -->
  <ThoughtDef>
    <defName>MLAP_IveBeenAdopted</defName>
    <durationDays>12</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>Adopted</label>
        <description>I’ve been adopted! A good pet can live a warm, safe life.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
