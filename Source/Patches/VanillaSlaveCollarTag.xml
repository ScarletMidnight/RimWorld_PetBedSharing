<Patch>

  <!-- Add a PetCollar tag to the Ideology slave collar.
       We attach <tags> to <apparel> directly, so it works without the tags node. -->
  <Operation Class="PatchOperationAdd" MayRequire="Ludeon.RimWorld.Ideology">
    <xpath>Defs/ThingDef[defName="Apparel_BodyStrap"]/apparel</xpath>
    <value>
      <tags>
        <li>PetCollar</li>
      </tags>
    </value>
  </Operation>

</Patch>
